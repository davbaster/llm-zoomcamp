          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT c.timestamp AS time, c.conversation_id, c.question, c.answer, c.model, c.response_time, c.cost, j.relevance AS judge_relevance, u.score AS user_score FROM conversations c LEFT JOIN feedback j ON j.conversation_id = c.conversation_id AND j.source = 'judge' LEFT JOIN feedback u ON u.conversation_id = c.conversation_id AND u.source = 'user' WHERE c.timestamp BETWEEN $__timeFrom() AND $__timeTo() ORDER BY c.timestamp DESC LIMIT 5",
          "refId": "A",
